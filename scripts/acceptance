#!/bin/sh
# help: Check working title, at the commit in acceptance/working-title/source, and compare its findings, the part each file resolves to and the archetype config's findings with the approved ones; --approve writes them.

set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
here="$root/acceptance/working-title"
read -r url sha <"$here/source"

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

git -C "$work" init --quiet
git -C "$work" fetch --quiet --depth 1 "$url" "$sha"
git -C "$work" checkout --quiet FETCH_HEAD
cp "$here/warp.config.json" "$here/warp.config.ts" "$work/"

(cd "$work" && node "$root/src/cli.ts" check --config warp.config.json --reporter json) >"$work/report.json"
node -e '
  const { findings } = JSON.parse(require("node:fs").readFileSync(process.argv[1], "utf8"));
  console.log([...new Set(findings.map((finding) => finding.key))].sort().join("\n"));
' "$work/report.json" >"$work/findings.txt"

(cd "$work" && node "$root/src/cli.ts" check --config warp.config.ts --reporter json) >"$work/archetype-report.json"
node -e '
  const { findings } = JSON.parse(require("node:fs").readFileSync(process.argv[1], "utf8"));
  console.log(findings.map((finding) => finding.key).sort().join("\n"));
' "$work/archetype-report.json" >"$work/archetype-findings.txt"

(cd "$work" && node "$root/src/cli.ts" model --config warp.config.ts --json) >"$work/model.json"
node -e '
  const { units } = JSON.parse(require("node:fs").readFileSync(process.argv[1], "utf8"));
  const lines = units.flatMap((unit) => {
    const parts = new Map(Object.entries(unit.parts).flatMap(([part, files]) => files.map((file) => [file, part])));
    return unit.ownFiles.map((file) => `${file} ${unit.id} ${parts.get(file) ?? (unit.archetype ? "-" : "(plain)")}`);
  });
  console.log(lines.sort().join("\n"));
' "$work/model.json" >"$work/model.txt"

if [ "${1:-}" = '--approve' ]; then
  cp "$work/findings.txt" "$here/findings.txt"
  cp "$work/model.txt" "$here/model.txt"
  cp "$work/archetype-findings.txt" "$here/archetype-findings.txt"
  echo "Approved $(wc -l <"$here/findings.txt" | tr -d ' ') findings, $(wc -l <"$here/model.txt" | tr -d ' ') files' parts and $(wc -l <"$here/archetype-findings.txt" | tr -d ' ') archetype findings at $sha."
  exit 0
fi

status=0
if diff -u "$here/findings.txt" "$work/findings.txt"; then
  echo "Working title at $sha has the approved $(wc -l <"$here/findings.txt" | tr -d ' ') findings."
else
  echo "error: working title's findings differ from acceptance/working-title/findings.txt (- approved, + now). If the change is intended, run ./do acceptance --approve." >&2
  status=1
fi
if diff -u "$here/model.txt" "$work/model.txt"; then
  echo "Working title at $sha resolves its $(wc -l <"$here/model.txt" | tr -d ' ') files to the approved parts."
else
  echo "error: working title's files resolve differently from acceptance/working-title/model.txt (- approved, + now). If the change is intended, run ./do acceptance --approve." >&2
  status=1
fi
if diff -u "$here/archetype-findings.txt" "$work/archetype-findings.txt"; then
  echo "Working title at $sha has the approved $(wc -l <"$here/archetype-findings.txt" | tr -d ' ') archetype findings."
else
  echo "error: working title's archetype findings differ from acceptance/working-title/archetype-findings.txt (- approved, + now). If the change is intended, run ./do acceptance --approve." >&2
  status=1
fi
exit "$status"
