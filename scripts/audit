#!/bin/sh
# help: Refuse a dependency this change brings in that has a known advisory, and warn about the ones the base already carried.

set -eu

base=${AUDIT_BASE:-}
if [ -z "$base" ]; then
  if [ -n "${GITHUB_BASE_REF:-}" ]; then
    base="origin/$GITHUB_BASE_REF"
  else
    base='origin/main'
  fi
fi

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

is_json() {
  node -e 'JSON.parse(require("node:fs").readFileSync(process.argv[1], "utf8"))' "$1" 2>/dev/null
}

no_answer() {
  if [ "${CI:-}" = 'true' ]; then
    echo "error: $1" >&2
    exit 1
  fi
  echo "warning: $1" >&2
  exit 0
}

pnpm audit --json >"$work/head.json" || true
is_json "$work/head.json" || no_answer 'the advisory service could not be reached, so nothing was audited'

git rev-parse -q --verify "$base^{commit}" >/dev/null ||
  {
    echo "error: $base is not readable. Fetch it, then try again." >&2
    exit 1
  }

if ! git cat-file -e "$base:pnpm-lock.yaml" 2>/dev/null; then
  echo '{}' >"$work/base.json"
  node "$(dirname "$0")/_audit.mjs" "$work/base.json" "$work/head.json" "$base, which has no lockfile"
  exit
fi

mkdir -p "$work/base"
git show "$base:pnpm-workspace.yaml" >"$work/base/pnpm-workspace.yaml" 2>/dev/null || rm -f "$work/base/pnpm-workspace.yaml"
for file in package.json pnpm-lock.yaml; do
  git show "$base:$file" >"$work/base/$file" 2>/dev/null ||
    {
      echo "error: $file is not readable at $base. Fetch it, then try again." >&2
      exit 1
    }
done

(cd "$work/base" && pnpm audit --json >"$work/base.json") || true
is_json "$work/base.json" || no_answer "the advisory service could not be reached to audit $base"

label=$base
if revision=$(git rev-parse --short "$base" 2>/dev/null); then
  label="$base ($revision)"
fi

node "$(dirname "$0")/_audit.mjs" "$work/base.json" "$work/head.json" "$label"
