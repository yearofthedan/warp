{
  "tsconfig": "tsconfig.json",
  "exclude": ["fixtures/**"],
  "kinds": {
    "integration-test": {
      "match": "src/**/*.integration.test.ts",
      "dependsOn": ["adapter", "entry", "app", "reporter", "model", "rules"],
      "rules": {
        "function-cohesion": false
      }
    },
    "unit-test": {
      "match": ["src/**/*.test.ts", "integrations/**/*.test.ts"],
      "dependsOn": ["entry", "app", "reporter", "model", "rules", "integration"],
      "rules": {
        "function-cohesion": false
      }
    },
    "e2e-test": {
      "match": ["e2e/**", "do.test.ts"],
      "dependsOn": [],
      "rules": {
        "function-cohesion": false
      }
    },
    "rules": {
      "match": "src/model/rules/**",
      "dependsOn": ["model"]
    },
    "model": {
      "match": "src/model/**",
      "dependsOn": []
    },
    "app": {
      "match": "src/app/**",
      "dependsOn": ["model"]
    },
    "reporter": {
      "match": "src/reporters/**",
      "dependsOn": ["model"]
    },
    "adapter": {
      "match": ["src/analysis/**", "src/config/**", "src/git/**"],
      "dependsOn": ["app", "model"]
    },
    "entry": {
      "match": ["src/cli.ts", "src/builtins.ts"],
      "dependsOn": ["adapter", "reporter", "app", "model", "rules"]
    },
    "api": {
      "match": "src/index.ts",
      "dependsOn": ["model"],
      "rules": {
        "no-cross-kind-reexport": {
          "allow": ["model"]
        }
      }
    },
    "integration": {
      "match": "integrations/**",
      "dependsOn": []
    },
    "tooling": {
      "match": "*.ts",
      "dependsOn": []
    }
  }
}
