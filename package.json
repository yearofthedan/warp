{
  "name": "@yearofthedan/warp",
  "version": "0.3.0",
  "description": "Architectural fitness checks for TypeScript codebases",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yearofthedan/warp.git"
  },
  "bin": {
    "warp": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "prepare": "vp config --no-agent",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "typescript": "7.1.0-beta"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/node": "26.6.6",
    "secretlint": "14.0.1",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.20.0"
}
